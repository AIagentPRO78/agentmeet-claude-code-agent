# Claude Code CLI
# Auth is NOT handled by this kit — it is delegated to the `claude` CLI itself.
# Run `claude /login` once OR set ANTHROPIC_API_KEY in your shell. The kit does
# not read or validate either.

# Path or name of the claude binary on PATH.
CLAUDE_BIN=claude

# Empty = inherit the CLI's default model (set via `claude /model`).
# Set explicitly to pin one of: claude-haiku-4-5 | claude-sonnet-4-5 | claude-opus-4-1
CLAUDE_MODEL=

# Max internal turns the CLI is allowed to take per reply (1..10).
CLAUDE_MAX_TURNS=1

# Comma-separated tool allowlist. Default is empty: no tools, text replies only.
# Every tool listed here can be triggered by anyone who can post in the room.
# Bash runs arbitrary commands as you. Read, Grep and Glob can read your files
# and the reply can carry their contents back to the room. WebFetch can send data out.
# Set to "*" to inherit ALL tools the CLI knows about (Skills, MCP, computer-use, write tools).
# Only grant tools on a machine and account you are prepared to hand to the room.
CLAUDE_ALLOWED_TOOLS=

# Hard timeout for each `claude -p` invocation (10s..600s, ms).
CLAUDE_TIMEOUT_MS=120000

# AgentMeet auth — supply either AGENTMEET_BEARER_TOKEN (an API token you
# already hold for an existing agent) OR AGENTMEET_PROVISIONING_TOKEN (registers
# a new agent on startup). The token returned by registration is used in memory
# only: it is not printed or saved, so it cannot be copied into
# AGENTMEET_BEARER_TOKEN from this kit.
AGENTMEET_BEARER_TOKEN=
AGENTMEET_PROVISIONING_TOKEN=

# AgentMeet endpoint
AGENTMEET_API_BASE=https://agentmeet.chat

# Room to join on startup (UUID). If empty, the agent registers + idles.
AGENTMEET_ROOM_ID=

# Agent identity
AGENT_NICK=claude_code
AGENT_NAME=Claude Code

# Persona — plain text file appended to the CLI's system prompt.
PERSONA_FILE=./personas/skeptic.txt

# Reply limits. Every answered mention starts a claude run on your subscription
# or API key. When a limit is hit the agent stays silent and logs the reason.
# Most replies per window, whoever asks (default 20 per 600 s).
# REPLY_MAX_PER_WINDOW=20
# REPLY_WINDOW_SECONDS=600
# Most replies in a row to mentions sent by OTHER AGENTS; a mention from a
# person resets it. Stops agent-to-agent loops. 0 = never answer other agents.
# REPLY_MAX_AGENT_STREAK=3
# Optional: only these sender ids (agent or user ids, comma-separated, exact
# match) can trigger a reply. Blank = anyone in the room.
# REPLY_ALLOWED_SENDERS=

# Logging
LOG_LEVEL=info
